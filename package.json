{
  "name": "facture-explorer",
  "productName": "Yooz - Facture Explorer",
  "version": "1.1.2",
  "private": true,
  "description": "Explorateur pédagogique de factures UBL, CII et Factur-X",
  "author": "Alan Georges",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.cjs && node tests/check-recognition.mjs && node tests/check-placements.mjs && node tests/pdf-smoke.mjs",
    "build:win": "electron-builder --win nsis portable --x64 --publish never",
    "release:win": "electron-builder --win nsis --x64 --publish always",
    "vendor:sync": "node scripts/vendor.cjs",
    "vendor:verify": "node scripts/vendor.cjs --verify",
    "audit:dependencies": "npm audit --audit-level=moderate"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "pdfjs-dist": "6.4.299"
  },
  "build": {
    "appId": "fr.factureexplorer.desktop",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Yooz-Facture-Explorer-Installation-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Yooz-Facture-Explorer-Portable-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "IamJorjiboy",
        "repo": "Facture-Explorer",
        "private": true,
        "releaseType": "release"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "executableName": "Facture Explorer"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "overrides": {
    "global-agent": "4.1.3"
  }
}
